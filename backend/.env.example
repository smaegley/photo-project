# Maegley Photo Album — backend config (copy to .env). SPEC §8.
# SQLite DB path (container mounts a /data volume; dev defaults to repo data/).
DB_PATH=/data/photos.db

# Image library mount (slides, index_cards, thumbnails). SPEC §3.1. Mounted
# read-WRITE — the app rotates slides and writes derivatives in place.
LIBRARY_ROOT=/mnt/photos/library

# Cloudflare Access (SPEC §6.3). Set BOTH to enforce JWT verification;
# leave blank for local dev (app runs as the dev user below).
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Local-dev identity (ignored once CF Access is enabled).
DEV_USER_EMAIL=steve@maegley.com
DEV_USER_ROLE=admin

# Cloudflare DNS token for Caddy TLS at photos.maegley.org (used by the proxy, not the app).
CLOUDFLARE_API_TOKEN=

# Backblaze B2 — masters for origin=digital photos (SPEC §13). Read-only, S3-compatible.
# Leave blank for slide/scan-only serving; set all four to enable the digital tier.
# The app reads this file (backend/.env) on dev; prod injects the same via compose.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=PhotoAlbum1
B2_ENDPOINT=s3.us-west-001.backblazeb2.com
