# Copy to .env on the deploy host and fill in. (.env is gitignored.)
# TLS + public cert are handled by Cloudflare (tunnel + edge); there is no
# CLOUDFLARE_API_TOKEN here. The tunnel has its own credentials in
# /etc/cloudflared (see infra/DEPLOY.md §2).

# Cloudflare Access (Zero Trust). Both required in production — when set, the API
# verifies the Cf-Access-Jwt-Assertion header and the dev bypass is OFF.
#   team domain e.g.  maegley.cloudflareaccess.com
#   aud = the Application Audience (AUD) tag from the Access application.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Where the 200GB photo library is mounted/shared on the deploy host. Mounted
# read-write into the API container at /mnt/photos/library (the app rotates
# slides in place and writes derivatives).
LIBRARY_ROOT_HOST=/mnt/photos/library
